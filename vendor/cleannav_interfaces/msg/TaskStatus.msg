# === Fields ===
# header.frame_id 为空
std_msgs/Header header
string<=16 interface_version
string<=64 execution_id         # 普通 mission 或返航 mission 实例 ID
                                # QUEUED 或尚未创建 execution 时可以为空
string<=128 command_id           # SCOPE_COMMAND: 当前命令 ID
                                # SCOPE_EXECUTION: 创建该 execution 的原始 command_id
uint16 task_id
uint8 status_scope
uint8 state
float32 progress                 # 0.0-1.0；-1.0 表示不可用
string<=128 active_target_id     # 视觉任务关联目标
float32 remaining_distance_m     # >=0；-1.0 表示不可用
int32 reason_code                # 非负 int32，已发布数值不得改变含义
string<=512 message              # 人类可读，不用于程序控制

# 说明:
# - message 不替代 reason_code
# - Terminal TaskStatus 必须缓存，用于 command_id 幂等重放
# - 控制命令自身的 command_id 不覆盖原 execution 的 command_id
