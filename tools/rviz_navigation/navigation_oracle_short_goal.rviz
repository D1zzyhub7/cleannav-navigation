Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
  - Class: rviz_default_plugins/Map
    Name: Frozen Map
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: false
    Topic:
      Value: /cleannav/localization/map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: true
    Alpha: 0.6
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Alpha: 0.6
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Style: Points
    Size (Pixels): 3
    Color: 255; 80; 0
    Alpha: 1
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/LaserScan
    Name: Mapping LiDAR
    Enabled: true
    Style: Points
    Size (Pixels): 3
    Color: 0; 180; 255
    Alpha: 1
    Topic:
      Value: /mapping/scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/TF
    Name: TF and Robot Pose
    Enabled: true
    Show Axes: true
    Show Names: false
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Current Robot Pose
    Enabled: true
    Topic:
      Value: /cleannav/simulation/localization_pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Nav2 Planned Path
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: MPPI Local Trajectory
    Enabled: true
    Topic:
      Value: /trajectories
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Namespaces: {}
  - Class: rviz_default_plugins/Polygon
    Name: Robot Footprint
    Enabled: true
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic: /cleannav/rviz/goal_pose
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /rtabmap/initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 18
      Angle: 0
      X: -0.0243
      Y: -0.0109
Window Geometry:
  Width: 1200
  Height: 800
